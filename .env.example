# Notion Integration Token
# Obtenelo en: https://www.notion.so/my-integrations
# Seleccioná la integración "Magellan Test" → "Internal Integration Secret"
# Sin el prefijo VITE_ a proposito: Vite incrusta cualquier variable con
# prefijo VITE_ en el bundle del navegador, y esa era exactamente la fuga
# de este token. Sin el prefijo el valor solo vive en el servidor (proxy de
# Vite en dev, Edge Function de Netlify en produccion) y nunca llega al browser.
# En produccion se configura en la UI de Netlify con scope Functions, NO en
# netlify.toml (las variables declaradas en netlify.toml no estan disponibles
# para las edge functions). El valor queda congelado al momento del deploy,
# asi que rotar el token requiere un redeploy.
NOTION_API_KEY=ntn_5...

# Notion Database ID — Magellan Pre-test
# Es el ID en la URL de la database: https://app.notion.com/p/{este-id}
VITE_NOTION_DATABASE_ID=de9..

# Contraseña de la vista Admin — cambiá esta línea para usar otra
VITE_ADMIN_PASSWORD=n..
